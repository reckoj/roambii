rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Base rule - authenticated users can read
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Default deny write
    }
    
    // User uploads - users can upload to their own folders
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public files - anyone can read, only authenticated users can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Agent profile pictures and package images
    match /agents/{agentId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == agentId;
    }
    
    // Package images in packages folder - simplified rule
    match /packages/{packageId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Simplified - any authenticated user can write
    }
    
    // Package images folder
    match /package_images/{userId}/{allPaths=**} {
      allow read: if true;  // Anyone can view package images
      allow write: if request.auth != null && request.auth.uid == userId;  // Only owner can upload
    }
    
    // Profile avatars - users can upload to their own avatar folder
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;  // Anyone can view profile avatars
      allow write: if request.auth != null && request.auth.uid == userId;  // Only owner can upload
    }
  }
} 