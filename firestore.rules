rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAgent() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgent == true;
    }

    // New function to check if user is in agent view mode (either permanent or temporary)
    function isInAgentMode() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgent == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgentTemp == true
      );
    }

    // Default rules for all collections
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Deny all writes by default
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Agents collection
    match /agents/{agentId} {
      allow read: if true; // Public read access for agents
      allow write: if isOwner(agentId);
    }
    
    // Packages collection (new rule)
    match /packages/{packageId} {
      allow read: if true; // Public read access for packages
      allow create: if isAuthenticated() && isInAgentMode();
      allow update, delete: if isAuthenticated() && (
        // Allow if user is the package's agent
        resource.data.agentId == request.auth.uid || 
        // Or if there's an agent field with an id property
        (resource.data.agent != null && resource.data.agent.id == request.auth.uid) ||
        // Or if it's a document reference to the agent doc
        (resource.data.agent != null && resource.data.agent == /databases/$(database)/documents/agents/$(request.auth.uid))
      );
    }
    
    // Package info collection
    match /package_info/{packageId} {
      allow read: if true; // Public read access for packages
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.agentId == request.auth.uid || isAgent());
    }
    
    // Reviews collection
    match /agent_reviews/{reviewId} {
      allow read: if true; // Public read access for reviews
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAgent());
    }
    
    // Chat rooms collection
    match /chat_rooms/{roomId} {
      allow read: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
      allow delete: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
    }
    
    // Clients collection
    match /clients/{clientId} {
      // TEMPORARY: Allow all operations for debugging
      allow read, write: if isAuthenticated();
      
      // COMMENTED OUT DURING DEBUGGING
      // // Anyone can read their own client records or if they're the agent
      // allow read: if isAuthenticated();
      // 
      // // Allow any authenticated user to create client relationships (for debugging)
      // allow create: if isAuthenticated();
      // 
      // // Updates require being the agent for that client
      // allow update: if isAuthenticated() && 
      //   (request.auth.uid == resource.data.agentId);
      // 
      // // Only agents can delete their own client records
      // allow delete: if isAuthenticated() && 
      //   (request.auth.uid == resource.data.agentId);
    }
  }
} 