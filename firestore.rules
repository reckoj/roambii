rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAgent() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgent == true;
    }

    // New function to check if user is in agent view mode (either permanent or temporary)
    function isInAgentMode() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgent == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAgentTemp == true
      );
    }

    // Default rules for all collections
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Deny all writes by default
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Agents collection
    match /agents/{agentId} {
      allow read: if true; // Public read access for agents
      allow write: if isOwner(agentId);
    }
    
    // Packages collection (new rule)
    match /packages/{packageId} {
      allow read: if true; // Public read access for packages
      allow create: if isAuthenticated() && isInAgentMode();
      allow update, delete: if isAuthenticated() && (
        // Allow if user is the package's agent
        resource.data.agentId == request.auth.uid || 
        // Or if there's an agent field with an id property
        (resource.data.agent != null && resource.data.agent.id == request.auth.uid) ||
        // Or if it's a document reference to the agent doc
        (resource.data.agent != null && resource.data.agent == /databases/$(database)/documents/agents/$(request.auth.uid))
      );
    }
    
    // Package info collection
    match /package_info/{packageId} {
      allow read: if true; // Public read access for packages
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.agentId == request.auth.uid || isAgent());
    }
    
    // Reviews collection
    match /agent_reviews/{reviewId} {
      allow read: if true; // Public read access for reviews
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAgent());
    }
    
    // Chat rooms collection
    match /chat_rooms/{roomId} {
      allow read: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
      allow delete: if isAuthenticated() && 
        (resource.data.participants[request.auth.uid] != null);
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.agentId == request.auth.uid);
    }
    
    // Itineraries collection
    match /itineraries/{itineraryId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // Allow create for authenticated users
      allow create: if isAuthenticated() && (
        // Only allow setting price if user is in agent mode
        !('price' in request.resource.data) || isInAgentMode()
      );
      
      // Allow update with special price field validation for non-agents
      allow update: if isAuthenticated() && (
        // User is the owner or itinerary is shared with them
        (resource.data.userId == request.auth.uid || 
         request.auth.uid in (resource.data.sharedWith || [])) && 
        (
          // If user is an agent, they can update any field
          isInAgentMode() ||
          // If user is not an agent, they can only update fields other than price
          // Check that price field is unchanged or doesn't exist in the update
          (!('price' in request.resource.data) || 
           !('price' in resource.data) ||
           request.resource.data.price == resource.data.price)
        )
      );
      
      // Allow delete if user is the owner
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Day plans collection
    match /dayPlans/{dayPlanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        // Check if user owns the parent itinerary or itinerary is shared with them
        get(/databases/$(database)/documents/itineraries/$(resource.data.itineraryId)).data.userId == request.auth.uid ||
        request.auth.uid in (get(/databases/$(database)/documents/itineraries/$(resource.data.itineraryId)).data.sharedWith || [])
      );
    }
    
    // Activities collection
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // For update/delete, check if user has access to the parent day plan's parent itinerary
      allow update, delete: if isAuthenticated() && (
        exists(/databases/$(database)/documents/dayPlans/$(resource.data.dayPlanId)) && 
        get(/databases/$(database)/documents/itineraries/$(
          get(/databases/$(database)/documents/dayPlans/$(resource.data.dayPlanId)).data.itineraryId
        )).data.userId == request.auth.uid ||
        request.auth.uid in (get(/databases/$(database)/documents/itineraries/$(
          get(/databases/$(database)/documents/dayPlans/$(resource.data.dayPlanId)).data.itineraryId
        )).data.sharedWith || [])
      );
    }
    
    // Clients collection
    match /clients/{clientId} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // Allow create for authenticated users
      allow create: if isAuthenticated();
      
      // Allow update if the user is the agent for this client or in agent mode
      allow update: if isAuthenticated() && (
        resource.data.agentId == request.auth.uid || 
        isInAgentMode()
      );
      
      // Allow delete only if the user is the agent for this client
      allow delete: if isAuthenticated() && resource.data.agentId == request.auth.uid;
    }
  }
} 